{
  "extends": [
    "next/core-web-vitals",
    "plugin:@typescript-eslint/recommended",
    "prettier"
  ],
  "plugins": [
    "@typescript-eslint",
  ],
  "rules": {
    "prettier/prettier": 2,
    "no-console": "warn",
    "@typescript-eslint/indent": "off",
    "quotes": [
      "error",
      "double"
    ],
    "semi": [
      2,
      "always"
    ]
  }
}